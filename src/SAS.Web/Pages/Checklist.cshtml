@page
@model SAS.Web.Pages.ChecklistModel
@{
    ViewData["Title"] = Model.Area is not null ? $"{Model.Area.Name} — {Model.Shift?.Name}" : "Checklist";
}

@if (Model.NotConfigured)
{
    <div class="page">
        <div class="card empty-state">
            No current task list is set up for this area and shift yet. Ask an admin to create one in
            <a href="/Admin">Admin</a>.
        </div>
    </div>
    return;
}

@{
    var submission = Model.Submission!;
    var items = Model.Items;
}

<div class="page @(Model.IsGridMode ? "wide" : "")" data-checklist-root
     data-submission-id="@submission.Id"
     data-total="@Model.TotalCount"
     data-answered="@Model.AnsweredCount"
     data-readonly="@(Model.IsReadOnly ? "1" : "0")"
     data-save-task-url="/api/checklist/save-task"
     data-save-checkpoint-url="/api/checklist/save-checkpoint"
     data-save-notes-url="/api/checklist/save-notes"
     data-save-meta-url="/api/checklist/save-meta"
     data-complete-url="/api/checklist/complete"
     data-home-url="/">

    @Html.AntiForgeryToken()

    <div class="session-bar">
        <div class="sf"><label>Date</label><input type="text" value="@Model.ChecklistDate.ToString("ddd dd MMM yyyy")" readonly></div>
        <div class="sf"><label>Department</label><input type="text" value="@Model.Department!.Name" readonly></div>
        <div class="sf"><label>Area</label><input type="text" value="@Model.Area!.Name" readonly style="font-weight:700;color:var(--red)"></div>
        <div class="sf"><label>Shift</label><input type="text" value="@Model.Shift!.Name" readonly></div>
        @if (Model.IsReadOnly)
        {
            <div class="sf" style="margin-left:auto"><label>Status</label><input type="text" value="Completed by @submission.CompletedBy" readonly style="color:var(--green);font-weight:700"></div>
        }
    </div>

    @if (Model.IsReadOnly)
    {
        <div class="ok-msg">Completed by @submission.CompletedBy on @submission.CompletedAt!.Value.ToLocalTime().ToString("g"). This checklist is read-only.</div>
    }

    <div class="card">
        <div class="progress-label">
            <span>Progress</span>
            <span class="count" id="progress-text">@Model.AnsweredCount of @Model.TotalCount</span>
        </div>
        <div class="progress-track"><div class="progress-fill" id="progress-fill" style="width:@(Model.TotalCount == 0 ? 0 : Model.AnsweredCount * 100 / Model.TotalCount)%"></div></div>
    </div>

    <div class="card">
        <div class="section-title">Checklist details</div>
        <div class="field-row">
            <div class="field">
                <label for="auditorNames">Auditor name(s)</label>
                <input type="text" id="auditorNames" value="@submission.AuditorNames" placeholder="Names of everyone on this checklist" @(Model.IsReadOnly ? "disabled" : "") />
            </div>
            <div class="field">
                <label for="location">Location</label>
                <input type="text" id="location" value="@submission.Location" @(Model.IsReadOnly ? "disabled" : "") />
            </div>
        </div>
    </div>

    @if (Model.Escalations.Any())
    {
        <div class="escalation-card">
            <div class="escalation-head">@Model.Escalations.Count issue@(Model.Escalations.Count == 1 ? "" : "s") to escalate</div>
            @foreach (var esc in Model.Escalations)
            {
                <div class="escalation-row">
                    <span class="escalation-text">@esc.Text</span>
                    <span class="escalation-meta">→ @esc.EscalateTo@(esc.Window is not null ? $" · {esc.Window}" : "")</span>
                </div>
            }
        </div>
    }

    <div class="card">
        <div class="section-title">HOD sign-off</div>
        <div class="field" style="margin-bottom:0">
            <label for="completedBy">HOD who reviewed and signed off this checklist</label>
            @if (Model.IsReadOnly)
            {
                <input type="text" id="completedBy" value="@submission.CompletedBy" disabled />
            }
            else if (Model.IsHod)
            {
                <select id="completedBy">
                    <option value="">Select the signing HOD…</option>
                    @foreach (var hod in Model.Hods)
                    {
                        <option value="@hod.DisplayName" selected="@(submission.CompletedBy == hod.DisplayName || (submission.CompletedBy is null && SAS.Web.Services.PortalNameMatcher.Matches(hod.DisplayName, Model.CurrentUserLabel)))">@hod.DisplayName</option>
                    }
                </select>
            }
            else
            {
                <input type="text" id="completedBy" value="" placeholder="Not yet signed off" disabled />
                <div class="q-hint" style="margin-top:6px">Signed in as <strong>@Model.CurrentUserLabel</strong>. Only an HOD can sign this checklist off — fill the checks in and hand it to an HOD to complete.</div>
            }
        </div>
    </div>

    @if (Model.IsGridMode)
    {
        @foreach (var cat in Model.GridCategories)
        {
            var slug = SAS.Web.Pages.ChecklistModel.CategorySlug(cat.Category);
            var cols = Math.Max(cat.Checkpoints.Count, 1);
            <div class="grid-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="qcol">Question</th>
                            @foreach (var cp in cat.Checkpoints)
                            {
                                <th class="hcol">
                                    @if (cp.Label.StartsWith("Hr "))
                                    {
                                        <text>Hr </text><span class="hnum">@cp.Label.Substring(3)</span>
                                    }
                                    else
                                    {
                                        @cp.Label
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="sec-row cat-@slug"><td class="acc"></td><td colspan="@cols">@cat.Category</td></tr>
                        @foreach (var item in cat.Items)
                        {
                            var resp = submission.TaskResponses.FirstOrDefault(r => r.TaskItemId == item.Id);
                            var answered = SAS.Web.Services.ChecklistProgress.IsItemAnswered(item, submission);
                            var hint = $"Checked by {item.ResponsibleRole}{(item.EscalateToRole is not null ? $" — escalate to {item.EscalateToRole}" : "")}{(item.EscalationWindow is not null ? $" ({item.EscalationWindow})" : "")}";
                            var hodOnly = SAS.Web.Pages.ChecklistModel.IsHodOnly(item);
                            var locked = Model.IsReadOnly || (hodOnly && !Model.IsHod);
                            <tr class="dr" data-item data-item-id="@item.Id" data-timeboxed="@(item.IsTimeBoxed ? "1" : "0")" data-item-answered="@(answered ? "1" : "0")">
                                <td class="ql">
                                    @item.Text
                                    @if (hodOnly)
                                    {
                                        <span class="hod-badge" title="Only an HOD can answer this check">HOD only</span>
                                    }
                                    <div class="q-hint">@hint</div>
                                </td>
                                @if (item.IsTimeBoxed)
                                {
                                    foreach (var cp in cat.Checkpoints)
                                    {
                                        var cr = resp?.CheckpointResponses.FirstOrDefault(c => c.TaskCheckpointId == cp.Id);
                                        <td class="cell" data-checkpoint-id="@cp.Id">
                                            <div class="yn-group">
                                                <button type="button" class="y @(cr?.Status == "Done" ? "active" : "")" data-action="Done" @(locked ? "disabled" : "")>Y</button>
                                                <button type="button" class="n @(cr?.Status == "Issue" ? "active" : "")" data-action="Issue" @(locked ? "disabled" : "")>N</button>
                                            </div>
                                        </td>
                                    }
                                }
                                else
                                {
                                    <td class="cell" colspan="@cols" style="text-align:left;padding:4px 14px">
                                        <div class="wide-toggle">
                                            <button type="button" class="done @(resp?.Status == "Done" ? "active" : "")" data-action="Done" @(locked ? "disabled" : "")>Done</button>
                                            <button type="button" class="issue @(resp?.Status == "Issue" ? "active" : "")" data-action="Issue" @(locked ? "disabled" : "")>Issue</button>
                                        </div>
                                    </td>
                                }
                            </tr>
                            <tr class="nr" data-note-row>
                                <td class="ql">Description</td>
                                <td class="nc" colspan="@cols">
                                    <textarea placeholder="Notes…" @(locked ? "disabled" : "")>@resp?.Notes</textarea>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        var taskNo = 0;
        @foreach (var item in items)
        {
            taskNo++;
            var resp = submission.TaskResponses.FirstOrDefault(r => r.TaskItemId == item.Id);
            var statusClass = resp?.Status == "Done" ? "status-done" : resp?.Status == "Issue" ? "status-issue" : "";
            var answered = SAS.Web.Services.ChecklistProgress.IsItemAnswered(item, submission);
            var hodOnly = SAS.Web.Pages.ChecklistModel.IsHodOnly(item);
            var locked = Model.IsReadOnly || (hodOnly && !Model.IsHod);
            <div class="task-card @statusClass @(answered ? "is-answered" : "")" data-item data-item-id="@item.Id" data-timeboxed="@(item.IsTimeBoxed ? "1" : "0")" data-item-answered="@(answered ? "1" : "0")">
                <div class="task-head">
                    <span class="task-no">@taskNo</span>
                    <div class="task-text">
                        @item.Text
                        @if (hodOnly)
                        {
                            <span class="hod-badge" title="Only an HOD can answer this check">HOD only</span>
                        }
                    </div>
                    <span class="task-tick" data-task-tick aria-hidden="true">@(answered ? "✓" : "")</span>
                </div>

                @if (item.IsTimeBoxed)
                {
                    <div class="cp-grid">
                        @foreach (var cp in item.Checkpoints.OrderBy(c => c.SortOrder))
                        {
                            var cr = resp?.CheckpointResponses.FirstOrDefault(c => c.TaskCheckpointId == cp.Id);
                            <div class="cp-cell" data-checkpoint-id="@cp.Id">
                                <div class="cp-label">@cp.Label</div>
                                <div class="cp-btns">
                                    <button type="button" class="cp-btn @(cr?.Status == "Done" ? "active-done" : "")" data-action="Done" @(locked ? "disabled" : "")>Done</button>
                                    <button type="button" class="cp-btn @(cr?.Status == "Issue" ? "active-issue" : "")" data-action="Issue" @(locked ? "disabled" : "")>Issue</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="task-notes" data-note-block style="display:@((resp?.CheckpointResponses.Any(c => c.Status == "Issue") == true) ? "block" : "none")">
                        <textarea placeholder="Describe the issue (required)" @(locked ? "disabled" : "")>@resp?.Notes</textarea>
                        <div class="hint">Notes are required while any checkpoint above is marked Issue.</div>
                    </div>
                }
                else
                {
                    <div class="task-actions">
                        <button type="button" class="btn-done @(resp?.Status == "Done" ? "active" : "")" data-action="Done" @(locked ? "disabled" : "")>Done</button>
                        <button type="button" class="btn-issue @(resp?.Status == "Issue" ? "active" : "")" data-action="Issue" @(locked ? "disabled" : "")>Issue</button>
                    </div>
                    <div class="task-notes" data-note-block style="display:@(resp?.Status == "Issue" ? "block" : "none")">
                        <textarea placeholder="Describe the issue (required)" @(locked ? "disabled" : "")>@resp?.Notes</textarea>
                        <div class="hint">Notes are required when Issue is selected.</div>
                    </div>
                }
                <div class="save-state" data-save-state></div>
            </div>
        }
    }

    <div style="height:20px"></div>
</div>

<div class="action-bar">
    <a class="btn ghost" href="/">Leave &amp; come back later</a>
    <a class="btn ghost" href="/api/checklist/pdf?areaId=@Model.Area!.Id&shiftId=@Model.Shift!.Id&date=@Model.ChecklistDate.ToString("yyyy-MM-dd")">Download PDF</a>
    @if (!Model.IsReadOnly)
    {
        <button class="btn primary" id="complete-btn" type="button">Complete checklist</button>
    }
</div>

@section Scripts {
    <script src="~/js/checklist.js" asp-append-version="true"></script>
}

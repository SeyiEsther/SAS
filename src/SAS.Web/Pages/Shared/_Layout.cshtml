@inject SAS.Web.Services.AccessService Access
@{
    var pg = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isAdminArea = pg == "/Admin" || pg.StartsWith("/Admin");
    var currentUser = Access.CurrentUser;
    // The role lookup hits the database. If that's unreachable the header must
    // still render — otherwise even the error page fails to load.
    var isHod = false;
    try { isHod = await Access.IsHodAsync(); } catch { }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is not null ? ViewData["Title"] + " — Support Audit System" : "Support Audit System")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="topbar">
    <div class="stripes">
        <div class="st" style="background:#CC1F2C;width:22px"></div>
        <div class="st" style="background:#9B1E8E;width:17px"></div>
        <div class="st" style="background:#0066B2;width:12px"></div>
        <div class="st" style="background:#00A651;width:9px"></div>
    </div>
    <div>
        <div class="brand">RITTAL</div>
        <div class="subbrand">Support Audit System</div>
    </div>
    <div class="topbar-right">
        @if (!string.IsNullOrWhiteSpace(currentUser.Label) && currentUser.Label != "unknown")
        {
            <span class="user-chip" title="@(isHod ? "Signed in as an HOD — you can sign checklists off" : "Signed in")">
                @currentUser.Label@(isHod ? " · HOD" : "")
            </span>
        }
        <a class="tbtn @(pg == "/Index" ? "active" : "")" href="/">Home</a>
        <a class="tbtn @(pg == "/Completed" ? "active" : "")" href="/Completed">Completed</a>
        <a class="tbtn @(isAdminArea ? "active" : "")" href="/Admin">Admin</a>
    </div>
</div>

<main class="app-main">
@RenderBody()
</main>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

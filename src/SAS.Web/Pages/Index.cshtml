@page
@model SAS.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="welcome-wrap">
    <div class="welcome-card">
        <div class="welcome-name">Safe Start Checklist</div>
        <div class="welcome-time">@DateTime.Now.ToString("dddd d MMMM yyyy")</div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="sf-row">
                <div class="fl">
                    <label>Date</label>
                    <input type="date" name="ChecklistDate" value="@Model.ChecklistDate" required>
                </div>
                <div class="fl">
                    <label>Shift <span style="color:var(--red)">*</span></label>
                    <select name="ShiftId" required>
                        <option value="">Select shift…</option>
                        @foreach (var grp in Model.Shifts.GroupBy(s => s.Department!.Name))
                        {
                            <optgroup label="@grp.Key">
                                @foreach (var shift in grp)
                                {
                                    <option value="@shift.Id" selected="@(Model.ShiftId == shift.Id)">@shift.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
            </div>

            <div class="fl" style="margin-bottom:6px">
                <label>Area <span style="color:var(--red)">*</span></label>
                <select name="AreaId" required>
                    <option value="">Select area…</option>
                    @foreach (var grp in Model.Areas.GroupBy(a => a.Department!.Name))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var area in grp)
                            {
                                var display = string.IsNullOrEmpty(area.DefaultLocation) || area.DefaultLocation == area.Name
                                    ? area.Name
                                    : $"{area.Name} ({area.DefaultLocation})";
                                <option value="@area.Id" selected="@(Model.AreaId == area.Id)">@display</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="err">@Model.Error</div>
            }

            <button type="submit" class="welcome-btn primary">Start checklist &rarr;</button>
        </form>
    </div>
</div>

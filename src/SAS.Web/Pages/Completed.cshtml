@page
@model SAS.Web.Pages.CompletedModel
@{
    ViewData["Title"] = "Completed checklists";
}

<div class="page wide">
    <div class="card">
        <h1 style="font-size:20px;margin-bottom:4px">Completed checklists</h1>
        <p class="checklist-head meta">Filter by department, area, shift and date range.</p>
    </div>

    <div class="card">
        <form method="get" class="filters">
            <div class="field">
                <label>Department</label>
                <select name="departmentId">
                    <option value="">All</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Area</label>
                <select name="areaId">
                    <option value="">All</option>
                    @foreach (var a in Model.Areas)
                    {
                        <option value="@a.Id" selected="@(Model.AreaId == a.Id)">@a.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>Shift</label>
                <select name="shiftId">
                    <option value="">All</option>
                    @foreach (var s in Model.Shifts)
                    {
                        <option value="@s.Id" selected="@(Model.ShiftId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>From</label>
                <input type="date" name="dateFrom" value="@Model.DateFrom" />
            </div>
            <div class="field">
                <label>To</label>
                <input type="date" name="dateTo" value="@Model.DateTo" />
            </div>
            <div class="field" style="min-width:0">
                <button class="btn primary" type="submit">Filter</button>
            </div>
        </form>
    </div>

    <div class="card" style="padding:0">
        @if (!Model.Rows.Any())
        {
            <div class="empty-state">No checklists match these filters.</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="data">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Department</th>
                            <th>Area</th>
                            <th>Shift</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Issues</th>
                            <th>Signed off by</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.Date.ToString("ddd dd MMM yyyy")</td>
                                <td>@row.Department</td>
                                <td>@row.Area</td>
                                <td>@row.Shift</td>
                                <td>
                                    @if (row.Completed)
                                    {
                                        <span class="badge zero">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge open">In progress</span>
                                    }
                                </td>
                                <td>@row.Answered / @row.Total</td>
                                <td><span class="badge @(row.Issues > 0 ? "some" : "zero")">@row.Issues</span></td>
                                <td>@(row.CompletedBy ?? "—")</td>
                                <td style="white-space:nowrap">
                                    <a class="btn small" href="/Checklist?areaId=@row.AreaId&shiftId=@row.ShiftId&date=@row.Date.ToString("yyyy-MM-dd")">Open</a>
                                    <a class="btn small" href="/Checklist?handler=Pdf&areaId=@row.AreaId&shiftId=@row.ShiftId&date=@row.Date.ToString("yyyy-MM-dd")">PDF</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
